  "author": "Eric Liu (https://github.com/metonym)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metonym/crassus.git"
  },
  "homepage": "https://github.com/metonym/crassus",
  "bugs": "https://github.com/metonym/crassus/issues",
  "type": "module",
  "exports": {
